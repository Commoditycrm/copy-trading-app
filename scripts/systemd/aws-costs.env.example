# /etc/kopyya/aws-costs.env on the QA host only. Not secrets — no keys here;
# the collector uses the EC2 instance role.
QA_COST_REGION=us-east-2
QA_COST_INSTANCE_ID=i-085045eefdda2e747
QA_COST_ALLOCATE_REGIONAL_EC2=true
# Optional, once the QA resources carry an activated cost-allocation tag:
# QA_COST_TAG_KEY=kopyya:env
# QA_COST_TAG_VALUE=qa
