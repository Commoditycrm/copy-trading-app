{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KopyyaQaCostExplorerRead",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage", "ce:GetCostForecast"],
      "Resource": "*"
    },
    {
      "Sid": "KopyyaQaAllocationCheck",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    }
  ]
}
