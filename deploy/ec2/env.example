# Root .env on the EC2 host (git-ignored, mode 600). Names only.
COMPOSE_PROJECT_NAME=copy-trading-app
# staging keeps the staging overlay; prod/QA drop it
COMPOSE_FILE=docker-compose.yml:deploy/ec2/docker-compose.prod.yml:deploy/ec2/docker-compose.staging.yml
# COMPOSE_PROFILES=discord        # prod: only from cutover on; QA: always

SITE_ADDRESS=                     # "kopyya.com, www.kopyya.com" | "test.kopyya.com"
POSTGRES_PASSWORD=
REDIS_PASSWORD=                   # backend/.env REDIS_URL must match
DISCORD_LISTENER_TOKEN=
